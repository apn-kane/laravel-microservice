# ===========================================
# Laravel Microservices - Environment Config
# ===========================================

# Database credentials (shared across all services)
DB_USERNAME=postgres
DB_PASSWORD=secret

# Database names
USER_DB_NAME=users_db
ORDER_DB_NAME=orders_db
PRODUCT_DB_NAME=products_db

# Exposed ports (host machine)
API_GATEWAY_PORT=8080
USER_SERVICE_PORT=8001
ORDER_SERVICE_PORT=8002
PRODUCT_SERVICE_PORT=8003

# Database exposed ports (host machine)
USER_DB_PORT=5432
ORDER_DB_PORT=5433
PRODUCT_DB_PORT=5434

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
